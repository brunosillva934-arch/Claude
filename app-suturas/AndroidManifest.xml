<?xml version="1.0" encoding="utf-8"?>
<!-- Nenhuma permissão: o app não usa a rede e só lê o arquivo que você escolhe ao restaurar uma cópia. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.treino.suturas">

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Suturas"
        android:theme="@style/Tema">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|fontScale|layoutDirection|locale"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: tela de abertura do sistema com o ícone do app sobre a cor de fundo. -->
    <style name="Tema" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/fundo</item>
        <item name="android:statusBarColor">@color/barra</item>
        <item name="android:navigationBarColor">@color/fundo</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/fundo</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_abertura</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/marca</item>
    </style>
</resources>

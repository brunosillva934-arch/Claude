<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema escuro, quando o sistema está em modo escuro. -->
    <style name="Tema" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/fundo</item>
        <item name="android:statusBarColor">@color/barra</item>
        <item name="android:navigationBarColor">@color/fundo</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>
</resources>

{
  "name": "bau-notas",
  "private": true,
  "version": "0.3.0",
  "description": "Baú: notas médicas em árvore, 100% offline, para tablet Android",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "verificar": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:android": "tsc --noEmit && vite build --mode android",
    "previa": "vite preview --port 4173 --strictPort",
    "apk": "bash android/montar.sh"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@xyflow/react": "^12.12.1",
    "lucide-react": "^1.73.0",
    "minisearch": "^7.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.3.0",
    "sql.js": "^1.16.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}

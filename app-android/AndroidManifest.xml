<?xml version="1.0" encoding="utf-8"?>
<!-- Nenhuma permissão: o app não usa a rede e só lê os arquivos que você escolhe. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.discursivas.treino">

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Discursivas"
        android:theme="@style/Tema">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|fontScale|layoutDirection|locale"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Abrir com" num TXT, a partir do gerenciador de arquivos ou dos downloads -->
            <intent-filter android:label="Responder no Discursivas">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" android:scheme="content" />
            </intent-filter>

            <!-- "Compartilhar" um ou mais TXT com o app -->
            <intent-filter android:label="Responder no Discursivas">
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
